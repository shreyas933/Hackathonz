# Brightloop Subscription Management System (SMS)
# Application Environment Configuration

# Database: SQLite for local sandbox development, or PostgreSQL for staging/production
DATABASE_URL=sqlite:///./brightloop.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brightloop_sms

# Security
JWT_SECRET_KEY=brightloop_super_secret_dev_key_change_in_production_987654321
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App URLs
FRONTEND_ORIGIN=http://localhost:5173
APP_ENV=development

# Currency settings
DEFAULT_CURRENCY=INR
DEFAULT_CURRENCY_SYMBOL=₹

